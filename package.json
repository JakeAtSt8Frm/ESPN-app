{
  "name": "espn-league-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "snapshot": "tsx scripts/snapshot.ts",
    "leagues": "tsx scripts/list-leagues.ts",
    "fit:projection": "tsx scripts/fit-projection.ts",
    "verify": "tsx scripts/verify-scoring.ts && tsx scripts/verify-analytics.ts && tsx scripts/verify-history.ts",
    "verify:analytics": "tsx scripts/verify-analytics.ts",
    "verify:trade": "tsx scripts/verify-trade.ts",
    "verify:stat-ids": "tsx scripts/verify-stat-ids.ts",
    "verify:projection": "tsx scripts/verify-projection.ts",
    "verify:forecast": "tsx scripts/verify-forecast.ts",
    "verify:lineup": "tsx scripts/verify-lineup.ts",
    "verify:lineup-alerts": "tsx scripts/verify-lineup-alerts.ts",
    "verify:predictions": "tsx scripts/verify-prediction-lab.ts",
    "report:forecast": "tsx scripts/report-forecast.ts",
    "verify:power": "tsx scripts/verify-power.ts",
    "verify:season": "tsx scripts/verify-season-value.ts",
    "verify:values": "tsx scripts/verify-player-values.ts",
    "research:forecast": "tsx scripts/research-forecast.ts",
    "research:boom-bust": "tsx scripts/research-boom-bust.ts",
    "research:matchup": "tsx scripts/research-matchup.ts",
    "typecheck": "tsc -b --noEmit",
    "verify:history": "tsx scripts/verify-history.ts",
    "fit:priors": "tsx scripts/fit-priors.ts",
    "serve": "tsx scripts/serve.ts",
    "restamp": "tsx scripts/restamp-fits.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
